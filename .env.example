# Variáveis de servidor. NUNCA comitar valores reais — só o nome fica aqui.
# Onde configurar:
#   - Local (dev): crie um arquivo .env.local (já ignorado pelo git).
#   - Produção (DirectAdmin): Node.js Selector → Variáveis de ambiente do app.

# Convite de alunos (Admin API do Supabase).
# Onde pegar: Supabase → Project Settings → API → "service_role" secret.
SUPABASE_SERVICE_ROLE_KEY=

# Integração com o Asaas (pagamento → libera acesso / atraso → bloqueia).
# Onde pegar a chave: Asaas → Integrações → API.
ASAAS_API_KEY=
# Token que você escolhe e cadastra em Asaas → Integrações → Webhooks (o Asaas
# devolve esse mesmo valor em todo evento, é como verificamos que é ele mesmo).
ASAAS_WEBHOOK_TOKEN=
# Opcional: aponte pro Asaas sandbox durante testes.
# ASAAS_API_BASE_URL=https://sandbox.asaas.com/api/v3

# Período gratuito público. Sem este valor, o cadastro/teste funciona, mas o
# botão de continuidade encaminha para o atendimento em vez de criar checkout.
TRIAL_MONTHLY_PRICE=
# Opcional: nome mostrado no checkout do Asaas.
# TRIAL_PLAN_NAME=Acesso digital Central School

# Senha simples pra proteger a rotina diária de bloqueio por atraso
# (/api/cron/bloquear-atrasados?secret=...). Invente uma string qualquer.
CRON_SECRET=

# Tutor de conversa por IA (/aluno/tutor).
# Onde pegar: platform.openai.com → API keys.
OPENAI_API_KEY=
# Opcional: modelo usado pelo tutor. Padrão: gpt-4o-mini.
# OPENAI_TUTOR_MODEL=gpt-4o-mini
